+            upper: vec![f64::INFINITY, f64::INFINITY, 1.],
+            basis: vec![0, 1],
+            basic: vec![true, true, false],
+            at_upper: vec![false; 3],
+            x: if true_negative {
+                vec![-1., 2., 0.]
