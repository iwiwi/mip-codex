+        assert!(s.refine_ratio(&[1., 0.], 1., 2).is_some());
+        assert_eq!(s.x[2], 0.);
+        assert!(s.x[0].abs() < FEAS);
+        assert!((s.x[1] - 1.).abs() < FEAS);
+        assert_eq!(s.stats.refinement_successes, 1);
+    }
+    #[test]
