+    (v.is_finite() && v.abs() <= (1u64 << 52) as f64 && v.fract() == 0.).then_some(v as i128)
+}
+fn gcd(mut a: i128, mut b: i128) -> i128 { while b != 0 { let r=a%b; a=b; b=r; } a }
