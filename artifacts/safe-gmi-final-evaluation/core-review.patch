+#[test]
+fn reporting_a_gmi_bound_preserves_the_fractional_search_root() {
+ for maximize in [false,true] {
+  let sense=if maximize {"OBJSENSE\n MAX\n"}else{""};let cost=if maximize{1}else{-1};
