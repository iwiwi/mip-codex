+                            _ => None,
+                        };
+                        let Some(numerator) =
+                            others.and_then(|v| rhs.sub(I::point(v)?)).map(|v| v.hi)
+                        else {
+                            continue;
+                        };
+                        let a1 = numerator / a.lo;
+                        let a2 = numerator / a.hi;
+                        if a.lo > 0. {
+                            let value = a1.max(a2).next_up();
