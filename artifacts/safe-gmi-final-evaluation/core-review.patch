+                                proof_work=proof_work.saturating_add(row.len());
+                                if steps.len()>=1024 || proof_work>2_000_000 {return(lower,upper,steps);}
+                                upper[j] = Some(value);
+                                steps.push(BoxStep{source_row:i,upper_side:sign>0.,variable:j,lower:false,value_bits:format!("{:016x}",value.to_bits())});
+                                changed = true;
+                            }
+                        } else {
+                            let value = a1.min(a2).next_down();
+                            if value.is_finite() {
+                                proof_work=proof_work.saturating_add(row.len());
